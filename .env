# === Base de données ===
DB_DIALECT=sqlite
SQLITE_PATH=./data/raw/immobilier.db

# === MLflow ===
MLFLOW_TRACKING_URI=./mlruns

# === Application Streamlit ===
STREAMLIT_PORT=8501
MODEL_NAME=xgboost  # peut être: linear, random_forest, xgboost

# === Optionnel (PostgreSQL si besoin plus tard) ===
POSTGRES_USER=ia_user
POSTGRES_PASSWORD=secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ia_immobilier
